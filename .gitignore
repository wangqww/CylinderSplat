# =========================
# Python cache and temp files
# =========================
**/__pycache__/
**/.cache/

# =========================
# OS-specific files
# =========================
**/.DS_Store

# =========================
# Generated outputs and experiment artifacts
# =========================
output/
outputs/
workdirs/
checkpoints/
hf_data/

# Model checkpoints and large generated assets
*.ckpt
*.png
